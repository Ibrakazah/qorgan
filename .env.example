# Copy to .env and fill in. Without a key the service runs in MOCK mode (task heuristics, no LLM).

# --- Provider: anthropic (default) | openai_compat (OpenRouter, vLLM, LM Studio, Ollama, ...)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5
# Global effort override for every task: low | medium | high | xhigh | max (empty = per-task default)
LLM_EFFORT=

# --- OpenAI-compatible server (only when LLM_PROVIDER=openai_compat)
# Set LLM_MODEL / LLM_FAST_MODEL to the provider's own model ids (check its catalog).
# Local servers without auth: use any placeholder key, e.g. OPENAI_COMPAT_API_KEY=local
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
# Set to false if the server rejects response_format=json_schema (the schema is also in the prompt)
OPENAI_COMPAT_JSON_SCHEMA=true

# --- Behaviour
LLM_MOCK=false
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# On LLM failure answer with the task heuristic (marked source=fallback) instead of HTTP 502
LLM_DEGRADE_ON_ERROR=true
# Anthropic server-side fallback model when a request is refused (only on models that support it)
LLM_REFUSAL_FALLBACK=true
CACHE_DIR=.cache/llm
CACHE_ENABLED=true
BATCH_CONCURRENCY=8
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
